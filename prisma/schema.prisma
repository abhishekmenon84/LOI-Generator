generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  accounts            Account[]
  sessions            Session[]
  memberships         Membership[]
  dealsCreated        Deal[]      @relation("DealCreator")
  dealSharesReceived  DealShare[] @relation("DealShareRecipient")
  dealSharesGranted   DealShare[] @relation("DealShareGrantor")
  foldersCreated      Folder[]    @relation("FolderCreator")
  ledgersCreated      Ledger[]    @relation("LedgerCreator")
  folderParticipations FolderParticipant[]
  uploadedFiles       FolderFile[]
  templatesCreated    CustomTemplate[]
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  accountType          String   @default("individual") // "individual" | "real_estate_agency" | "company" | "corporation"
  isPersonal           Boolean  @default(true)
  logoUrl              String?
  planTier             String   @default("trial") // "trial" | "tier_1_10" | "tier_11_30" | "tier_31_50" | "enterprise" | "expired"
  trialEndsAt          DateTime?
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  memberships Membership[]
  deals       Deal[]
  folders     Folder[]
  receipts    Receipt[]
  customTemplates CustomTemplate[]
}

model Membership {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role   String  @default("member") // "admin" | "member"
  active Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

model ProcessedWebhookEvent {
  id          String   @id // Stripe event.id — dedup key
  processedAt DateTime @default(now())
}

model Receipt {
  id                String   @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stripeInvoiceId   String   @unique
  amountPaid        Int
  currency          String
  status            String
  hostedInvoiceUrl  String?
  createdAt         DateTime @default(now())

  @@index([orgId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Deal {
  id              String   @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdBy       User     @relation("DealCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  name            String
  documentType    String   @default("purchase_loi")
  formData        Json
  stage           String   @default("draft") // "draft" | "active" | "pending" | "closed"
  locked          Boolean  @default(false)
  archivedAt      DateTime?
  deletedAt       DateTime?
  parentDealId    String?
  parent          Deal?    @relation("DealThreads", fields: [parentDealId], references: [id], onDelete: Cascade)
  children        Deal[]   @relation("DealThreads")
  priority        String?  // "green" | "yellow" | "grey" | null
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shares            DealShare[]

  @@index([orgId])
  @@index([createdByUserId])
  @@index([parentDealId])
}

model DealShare {
  id              String   @id @default(cuid())
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  grantedToUserId String
  grantedTo       User     @relation("DealShareRecipient", fields: [grantedToUserId], references: [id], onDelete: Cascade)
  grantedByUserId String
  grantedBy       User     @relation("DealShareGrantor", fields: [grantedByUserId], references: [id], onDelete: Cascade)
  permission      String   @default("read") // "read" | "write"
  createdAt       DateTime @default(now())

  @@unique([dealId, grantedToUserId])
  @@index([dealId])
  @@index([grantedToUserId])
}

model SignatureRequest {
  id          String   @id @default(cuid())
  ledgerId    String
  ledger      Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // "pending" | "fully_executed" | "voided"
  verifyCode  String   @unique
  createdByUserId String
  finalDocumentHash String?
  createdAt   DateTime @default(now())
  voidedAt    DateTime?

  signers SignerSlot[]

  @@index([ledgerId])
}

model SignerSlot {
  id             String   @id @default(cuid())
  requestId      String
  request        SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind           String   @default("signer") // "signer" | "notify_only"
  role           String
  roleOtherLabel String?
  name           String
  email          String
  signingToken   String?  @unique
  tokenUsedAt    DateTime?
  createdAt      DateTime @default(now())

  signatureEvent SignatureEvent?

  @@index([requestId])
}

model SignatureEvent {
  id                String   @id @default(cuid())
  signerSlotId      String   @unique
  signerSlot        SignerSlot @relation(fields: [signerSlotId], references: [id], onDelete: Cascade)
  signatureImageUrl String
  documentHash      String
  userAgent         String
  screenInfo        String
  timezoneOffset    Int
  ipAddress         String
  geoCountry        String?
  geoRegion         String?
  geoCity           String?
  signedAt          DateTime @default(now())
}

model Folder {
  id              String    @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdBy       User      @relation("FolderCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  name            String
  stage           String    @default("draft") // "draft" | "active" | "pending" | "closed"
  priority        String?   // "green" | "yellow" | "grey" | null
  archivedAt      DateTime?
  deletedAt       DateTime?
  parentFolderId  String?
  parent          Folder?   @relation("FolderTree", fields: [parentFolderId], references: [id], onDelete: Cascade)
  children        Folder[]  @relation("FolderTree")
  ledgers         Ledger[]
  participants    FolderParticipant[]
  auditEvents     FolderAuditEvent[]
  files           FolderFile[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orgId])
  @@index([createdByUserId])
  @@index([parentFolderId])
}

model FolderParticipant {
  id            String   @id @default(cuid())
  folderId      String
  folder        Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission    String   @default("read") // "read" | "write"
  addedByUserId String
  createdAt     DateTime @default(now())

  @@unique([folderId, userId])
  @@index([folderId])
  @@index([userId])
}

model FolderAuditEvent {
  id         String   @id @default(cuid())
  folderId   String
  folder     Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  actorUserId String
  action     String   // "archived" | "trashed" | "restored" | "created" | "moved" | "linked_child" | "unlinked_child"
  reason     String?  // mandatory for archived/trashed/restored, null for system-generated events like "created"
  createdAt  DateTime @default(now())

  @@index([folderId])
}

model Ledger {
  id              String   @id @default(cuid())
  folderId        String
  folder          Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdBy       User     @relation("LedgerCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  name            String
  documentType    String   @default("purchase_loi")
  formData        Json
  locked          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  signatureRequests SignatureRequest[]

  @@index([folderId])
  @@index([createdByUserId])
}

model FolderFile {
  id                String   @id @default(cuid())
  folderId          String
  folder            Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name              String
  fileUrl           String
  mimeType          String
  pageCount         Int?
  fieldTier         String   @default("plain") // "plain" | "auto_detected" | "manual"
  formValues        Json?
  uploadedByUserId  String
  uploadedBy        User     @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  anchors FolderFileAnchor[]

  @@index([folderId])
}

model FolderFileAnchor {
  id           String     @id @default(cuid())
  folderFileId String
  folderFile   FolderFile @relation(fields: [folderFileId], references: [id], onDelete: Cascade)
  type         String     // "signature" | "date" | "initials" | "text" | "checkbox" | "radio"
  label        String
  page         Int
  xPct         Float
  yPct         Float
  widthPct     Float
  heightPct    Float

  @@index([folderFileId])
}

model CustomTemplate {
  id              String   @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  pdfUrl          String
  pageCount       Int
  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  anchors TemplateAnchor[]

  @@index([orgId])
}

model TemplateAnchor {
  id         String         @id @default(cuid())
  templateId String
  template   CustomTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  type       String         // "signature" | "date" | "initials" | "text" | "checkbox" | "radio"
  role       String         // admin-defined signer role label, e.g. "Buyer" -- distinct name from FolderFileAnchor.label (see Task 3's note on reconciling this at the AnchorEditor call site)
  page       Int
  xPct       Float
  yPct       Float
  widthPct   Float
  heightPct  Float

  @@index([templateId])
}
