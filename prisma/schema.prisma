generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  phone           String?
  licenseNumber   String?
  signatureImageUrl String?
  accounts            Account[]
  sessions            Session[]
  memberships         Membership[]
  dealsCreated        Deal[]      @relation("DealCreator")
  dealSharesReceived  DealShare[] @relation("DealShareRecipient")
  dealSharesGranted   DealShare[] @relation("DealShareGrantor")
  foldersCreated      Folder[]    @relation("FolderCreator")
  ledgersCreated      Ledger[]    @relation("LedgerCreator")
  folderParticipations FolderParticipant[]
  uploadedFiles       FolderFile[]
  templatesCreated    CustomTemplate[]
  formTemplatesCreated FormTemplate[]
  contactsCreated     Contact[]
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  accountType          String   @default("individual") // "individual" | "real_estate_agency" | "company" | "corporation"
  isPersonal           Boolean  @default(true)
  logoUrl              String?
  // The user who created this org (its "founding admin" / owner) --
  // recorded explicitly rather than inferred from Membership.createdAt,
  // since only this user (not just "any admin") is allowed to promote or
  // demote the org's one other admin slot (business orgs: max 2 admins
  // total). Null for orgs created before this field existed.
  ownerUserId          String?
  // Personal orgs: always "free" (the pay-per-document tier -- no more
  // subscription tiers for Personal). Business orgs: "trial" | "growth" |
  // "professional" | "business" | "enterprise" | "scale" | "expired".
  planTier             String   @default("free")
  retentionYears       Int      @default(1)
  trialEndsAt          DateTime?
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  memberships Membership[]
  deals       Deal[]
  folders     Folder[]
  receipts    Receipt[]
  customTemplates CustomTemplate[]
  formTemplates   FormTemplate[]
  usageCounter    UsageCounter?
  contacts        Contact[]
}

// A person or company the org deals with (buyer, seller, landlord,
// tenant, loan officer, mortgage broker, org admin, etc -- role is
// free-text, matching SignerSlot.role's existing convention rather than
// a fixed enum, since real-estate deal roles vary by deal type). Manually
// created/edited, org-scoped like CustomTemplate/FormTemplate. Document
// count and last-activity shown in the UI are computed by matching this
// Contact's email against SignerSlot rows at query time, not stored here
// -- they're derived facts about existing signature requests, not
// properties of the Contact itself.
model Contact {
  id              String   @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  role            String
  email           String?
  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orgId])
}

// Tracks an org's usage against its tier's document/e-signature limits.
// One row per org (not one per historical period). dayStart/dayCount back
// the daily caps (Personal: 5/day; Business: seats x docs/seat/day);
// periodStart/periodEnd/monthCount back the monthly caps (Personal: 30/mo
// hard cap; Business: monthly seat quota) -- lib/orgBilling.js's
// checkAndIncrementUsage rolls each window forward by resetting its own
// counter/dates when now() has passed it, independently of the other
// window. pendingOverageCents accumulates $0.50/doc (Business, over
// quota) or $2.00/doc (Personal, every document -- there is no
// subscription to cover it) between monthly Stripe invoice runs; a cron
// or manual job reads and zeroes this via lib/orgBilling.js, then invoices
// the org's Stripe customer for the amount billed.
model UsageCounter {
  id                   String       @id @default(cuid())
  orgId                String       @unique
  org                  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  dayStart             DateTime
  dayCount             Int          @default(0)
  periodStart          DateTime
  periodEnd            DateTime
  monthCount           Int          @default(0)
  esignRequestsSent    Int          @default(0)
  pendingOverageCents  Int          @default(0)
  updatedAt            DateTime     @updatedAt
}

model Membership {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role   String  @default("member") // "admin" | "member"
  active Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

model ProcessedWebhookEvent {
  id          String   @id // Stripe event.id — dedup key
  processedAt DateTime @default(now())
}

model Receipt {
  id                String   @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stripeInvoiceId   String   @unique
  amountPaid        Int
  currency          String
  status            String
  hostedInvoiceUrl  String?
  createdAt         DateTime @default(now())

  @@index([orgId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Deal {
  id              String   @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdBy       User     @relation("DealCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  name            String
  documentType    String   @default("purchase_loi")
  formData        Json
  stage           String   @default("draft") // "draft" | "active" | "pending" | "closed"
  locked          Boolean  @default(false)
  archivedAt      DateTime?
  deletedAt       DateTime?
  parentDealId    String?
  parent          Deal?    @relation("DealThreads", fields: [parentDealId], references: [id], onDelete: Cascade)
  children        Deal[]   @relation("DealThreads")
  priority        String?  // "green" | "yellow" | "grey" | null
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shares            DealShare[]

  @@index([orgId])
  @@index([createdByUserId])
  @@index([parentDealId])
}

model DealShare {
  id              String   @id @default(cuid())
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  grantedToUserId String
  grantedTo       User     @relation("DealShareRecipient", fields: [grantedToUserId], references: [id], onDelete: Cascade)
  grantedByUserId String
  grantedBy       User     @relation("DealShareGrantor", fields: [grantedByUserId], references: [id], onDelete: Cascade)
  permission      String   @default("read") // "read" | "write"
  createdAt       DateTime @default(now())

  @@unique([dealId, grantedToUserId])
  @@index([dealId])
  @@index([grantedToUserId])
}

model SignatureRequest {
  id          String   @id @default(cuid())
  ledgerId    String
  ledger      Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // "pending" | "fully_executed" | "voided"
  verifyCode  String   @unique
  createdByUserId String
  finalDocumentHash String?
  createdAt   DateTime @default(now())
  voidedAt    DateTime?
  // Set if the post-signing PDF burn or completion email failed after the
  // request was already marked fully_executed -- surfaces the failure to
  // admins instead of it being silently swallowed (see signatureFinalize.js).
  deliveryError String?
  // Snapshot of the Ledger's content (formData/documentType/templateId) at
  // the moment this SignatureRequest was created -- NOT a live reference to
  // Ledger.formData. Every signer sees and signs this frozen snapshot, and
  // finalization renders from it too, so editing the Ledger after voiding a
  // request (to send a corrected version) can never retroactively change
  // what an earlier signer actually agreed to. This is the minimal fix for
  // "what did each signer actually see" -- a full version-history table
  // across every edit is a separate, larger feature not built here.
  snapshotFormData     Json
  snapshotDocumentType String
  snapshotTemplateId   String?

  signers SignerSlot[]

  @@index([ledgerId])
}

model SignerSlot {
  id             String   @id @default(cuid())
  requestId      String
  request        SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind           String   @default("signer") // "signer" | "notify_only"
  role           String
  roleOtherLabel String?
  name           String
  email          String
  signingToken   String?  @unique
  tokenUsedAt    DateTime?
  createdAt      DateTime @default(now())

  signatureEvent SignatureEvent?

  @@index([requestId])
}

model SignatureEvent {
  id                String   @id @default(cuid())
  signerSlotId      String   @unique
  signerSlot        SignerSlot @relation(fields: [signerSlotId], references: [id], onDelete: Cascade)
  signatureImageUrl String
  documentHash      String
  userAgent         String
  screenInfo        String
  timezoneOffset    Int
  ipAddress         String
  geoCountry        String?
  geoRegion         String?
  geoCity           String?
  signedAt          DateTime @default(now())
}

model Folder {
  id              String    @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdBy       User      @relation("FolderCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  name            String
  stage           String    @default("draft") // "draft" | "active" | "pending" | "closed"
  priority        String?   // "green" | "yellow" | "grey" | null
  favorite        Boolean   @default(false)
  // Opt-in, defaults false (no behavior change for existing folders). When
  // true, org admins no longer get automatic blanket access to this one
  // folder purely by virtue of being an admin -- only the creator and
  // explicit FolderParticipant grants can see it. Lets a brokerage keep a
  // specific client's deal confidential from other admins/staff in the
  // same org, without changing the default (every admin sees everything)
  // for every other folder.
  restrictedToParticipants Boolean @default(false)
  archivedAt      DateTime?
  parentFolderId  String?
  parent          Folder?   @relation("FolderTree", fields: [parentFolderId], references: [id], onDelete: Cascade)
  children        Folder[]  @relation("FolderTree")
  ledgers         Ledger[]
  participants    FolderParticipant[]
  auditEvents     FolderAuditEvent[]
  files           FolderFile[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orgId])
  @@index([createdByUserId])
  @@index([parentFolderId])
}

model FolderParticipant {
  id            String   @id @default(cuid())
  folderId      String
  folder        Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission    String   @default("read") // "read" | "write"
  addedByUserId String
  createdAt     DateTime @default(now())

  @@unique([folderId, userId])
  @@index([folderId])
  @@index([userId])
}

model FolderAuditEvent {
  id         String   @id @default(cuid())
  folderId   String
  folder     Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  actorUserId String
  action     String   // "archived" | "trashed" | "restored" | "created" | "moved" | "linked_child" | "unlinked_child"
  reason     String?  // mandatory for archived/trashed/restored, null for system-generated events like "created"
  createdAt  DateTime @default(now())

  @@index([folderId])
}

model Ledger {
  id              String   @id @default(cuid())
  folderId        String
  folder          Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdBy       User     @relation("LedgerCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  name            String
  documentType    String   @default("purchase_loi")
  formData        Json
  locked          Boolean  @default(false)
  // Document-level archive, distinct from Folder.archivedAt -- archiving a
  // single Ledger inside a folder does not touch the folder itself or its
  // other documents.
  archivedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  templateId String?
  template   FormTemplate? @relation(fields: [templateId], references: [id])

  signatureRequests SignatureRequest[]

  @@index([folderId])
  @@index([createdByUserId])
}

model FolderFile {
  id                String   @id @default(cuid())
  folderId          String
  folder            Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name              String
  fileUrl           String
  mimeType          String
  pageCount         Int?
  fieldTier         String   @default("plain") // "plain" | "auto_detected" | "manual"
  formValues        Json?
  // Document-level archive, distinct from Folder.archivedAt -- archiving a
  // single uploaded file inside a folder does not touch the folder itself
  // or its other documents.
  archivedAt        DateTime?
  uploadedByUserId  String
  uploadedBy        User     @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  anchors FolderFileAnchor[]

  @@index([folderId])
}

model FolderFileAnchor {
  id           String     @id @default(cuid())
  folderFileId String
  folderFile   FolderFile @relation(fields: [folderFileId], references: [id], onDelete: Cascade)
  type         String     // "signature" | "date" | "initials" | "text" | "checkbox" | "radio"
  label        String
  page         Int
  xPct         Float
  yPct         Float
  widthPct     Float
  heightPct    Float

  @@index([folderFileId])
}

model CustomTemplate {
  id              String   @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  pdfUrl          String
  pageCount       Int
  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  anchors TemplateAnchor[]

  @@index([orgId])
}

model TemplateAnchor {
  id         String         @id @default(cuid())
  templateId String
  template   CustomTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  type       String         // "signature" | "date" | "initials" | "text" | "checkbox" | "radio"
  role       String         // admin-defined signer role label, e.g. "Buyer" -- distinct name from FolderFileAnchor.label (see Task 3's note on reconciling this at the AnchorEditor call site)
  page       Int
  xPct       Float
  yPct       Float
  widthPct   Float
  heightPct  Float
  customQuestion String?    // optional admin-authored wizard question override; falls back to an auto-generated question when null (see lib/customTemplateQuestions.mjs)

  @@index([templateId])
}

model FormTemplate {
  id              String   @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  pdfUrl          String
  pageCount       Int
  sourceTier      String   @default("manual") // "acroform" | "detected" | "manual"
  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fields  FormField[]
  ledgers Ledger[]

  @@index([orgId])
}

// Sliding-window request counter for rate-limiting public, unauthenticated
// endpoints (sign/[token], verify/[verifyCode]) that are reachable by
// anyone with a link and would otherwise have no throttling at all.
model RateLimitHit {
  id        String   @id @default(cuid())
  bucketKey String
  createdAt DateTime @default(now())

  @@index([bucketKey, createdAt])
}

model FormField {
  id         String       @id @default(cuid())
  templateId String
  template   FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key        String
  label      String
  type       String   // "text" | "checkbox" | "radio" | "date" | "signature" | "initials"
  page       Int
  xPct       Float
  yPct       Float
  widthPct   Float
  heightPct  Float
  required   Boolean  @default(false)
  radioGroup String?
  signerRole String?
  confidence Float?
  order      Int      @default(0)

  @@unique([templateId, key])
  @@index([templateId])
}
