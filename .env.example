# Optional overrides for lib/formDetect.js's in-browser form field detector.
# Leave unset to fetch FFDNet weights directly from HuggingFace (the
# deliberate default -- see lib/formDetect.js for why weights are not
# rehosted on our own Blob storage). Only set these if the model license is
# clarified and the weights are mirrored to our own object storage.
NEXT_PUBLIC_FFDNET_S_URL=""
NEXT_PUBLIC_FFDNET_L_URL=""
