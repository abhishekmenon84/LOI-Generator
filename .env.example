DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
RESEND_API_KEY="re_xxxxxxxxxxxx"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Required for template PDF uploads (lib/blobStorage.js). Create a Vercel
# Blob store under Project > Storage in the Vercel dashboard (free on the
# Hobby plan: 1GB storage / 10GB bandwidth), then run
# `npx vercel env pull .env.local` to fetch this automatically.
BLOB_READ_WRITE_TOKEN=""

# Optional overrides for lib/formDetect.js's in-browser form field detector.
# Leave unset to fetch FFDNet weights directly from HuggingFace (the
# deliberate default -- see lib/formDetect.js for why weights are not
# rehosted on our own Blob storage). Only set these if the model license is
# clarified and the weights are mirrored to our own object storage.
NEXT_PUBLIC_FFDNET_S_URL=""
NEXT_PUBLIC_FFDNET_L_URL=""
