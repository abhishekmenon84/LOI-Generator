DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
RESEND_API_KEY="re_xxxxxxxxxxxx"
# Must be an address on a domain verified in Resend (resend.com/domains) --
# without this, every send falls back to Resend's sandbox sender, which
# only delivers to the account's own email (see lib/sendEmail.js).
RESEND_FROM_EMAIL="Ledgerlot <notification@yourdomain.com>"
# Optional: recipient replies go here instead of RESEND_FROM_EMAIL's address.
RESEND_REPLY_TO="support@yourdomain.com"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Required for template PDF uploads (lib/blobStorage.js). Create a Vercel
# Blob store under Project > Storage in the Vercel dashboard (free on the
# Hobby plan: 1GB storage / 10GB bandwidth), then run
# `npx vercel env pull .env.local` to fetch this automatically.
BLOB_READ_WRITE_TOKEN=""

# Optional overrides for lib/formDetect.js's in-browser form field detector.
# Leave unset to fetch FFDNet weights directly from HuggingFace (the
# deliberate default -- see lib/formDetect.js for why weights are not
# rehosted on our own Blob storage). Only set these if the model license is
# clarified and the weights are mirrored to our own object storage.
NEXT_PUBLIC_FFDNET_S_URL=""
NEXT_PUBLIC_FFDNET_L_URL=""

# Optional -- error monitoring (lib/signatureFinalize.js and others report
# via @sentry/nextjs). Leave unset and the SDK is a documented no-op; set
# once a project exists at sentry.io to start receiving errors. SENTRY_ORG/
# SENTRY_PROJECT/SENTRY_AUTH_TOKEN are only needed to upload source maps at
# build time (next.config.mjs skips that step entirely without a token).
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Required for the daily signature-reminder cron (vercel.json, app/api/cron/
# signature-reminders) -- Vercel automatically sends this as a Bearer token
# on scheduled invocations when set as a project env var; generate any long
# random string (e.g. `openssl rand -base64 32`).
CRON_SECRET=""

# Comma-separated list of email addresses allowed to approve/reject
# business verification submissions (app/api/admin/business-verifications/*,
# lib/platformAdmin.js) -- a platform-level admin concept distinct from
# Organization/Membership.role admin (which is scoped to one org and would
# let an org admin approve their own submission). Example:
# "you@example.com,teammate@example.com"
PLATFORM_ADMIN_EMAILS=""

# ── Backup / disaster-recovery ──────────────────────────────────────────
# Database (Neon Postgres): Neon takes automatic point-in-time-recovery
# snapshots on paid plans (retention window depends on plan tier -- verify
# the current plan's PITR window in the Neon dashboard under Backup &
# Restore). No separate backup job exists in this codebase; recovery for
# an accidental delete/corruption relies entirely on Neon's own PITR.
# Before increasing reliance on this (e.g. for an enterprise customer's
# due-diligence questionnaire), confirm the actual PITR window and
# consider a periodic `pg_dump` exported to a second location (e.g. a
# private Vercel Blob path or S3) for a longer/independent retention copy.
#
# File storage (Vercel Blob): no built-in point-in-time recovery or
# versioning -- an overwritten/deleted blob (uploaded PDFs, signature
# images, org logos) is not recoverable via Vercel. The Ledger.formData
# JSON and SignatureEvent rows in Postgres are the actual source of truth
# for regenerating a document (see lib/dealPdfBuilder.js), so Blob loss is
# largely (not entirely -- FolderFile plain-attachment uploads have no
# such fallback) recoverable from the database alone.
